{
  "name": "cookie-heist",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Cookie Heist - a cosy 3D stealth puzzle game for the web",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:gd": "tsc --noEmit && vite build --mode gd",
    "build:web": "tsc --noEmit && vite build --mode web",
    "build:gamepix": "tsc --noEmit && vite build --mode gamepix",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "test:e2e:gd": "playwright test -c playwright.gd.config.ts --trace off",
    "playtest": "tsx scripts/playtest/run.ts --runs 32 --strict --md docs/playtest.md",
    "check:levels": "tsx scripts/playtest/check.ts",
    "check:audit": "tsx scripts/playtest/audit.ts",
    "shots": "node scripts/screenshots.mjs",
    "submission": "node scripts/submission/build.mjs",
    "submission:gd": "node scripts/submission/build-gd.mjs",
    "submission:gamepix": "node scripts/submission/build-gamepix.mjs",
    "submission:web": "npm run build:web && node scripts/web/zip.mjs",
    "check:web": "node scripts/web/check.mjs",
    "store:web": "node scripts/web/store.mjs",
    "check:locales": "node scripts/check-locales.mjs",
    "perf": "node scripts/perf/measure.mjs dist 3",
    "covers": "node scripts/submission/covers-v3.mjs http://127.0.0.1:4174/",
    "trailers": "node scripts/submission/trailer-v3.mjs http://127.0.0.1:4174/ 1920 1080 submission/videos/trailer-v3-1920x1080.mp4 && node scripts/submission/trailer-v3.mjs http://127.0.0.1:4174/ 1080 1620 submission/videos/trailer-v3-1080x1620.mp4",
    "media:first-minute": "tsx scripts/media/first-minute.ts http://127.0.0.1:4174/ docs/media/first-minute-v3-390x844.mp4"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource/fredoka": "^5.2.8",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.6",
    "@types/three": "0.170.0",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.1",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.7"
  }
}
