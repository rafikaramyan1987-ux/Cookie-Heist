{
  "name": "cookie-heist",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cookie Heist - a cosy 3D stealth puzzle game for the web",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "playtest": "tsx scripts/playtest/run.ts --runs 24 --md docs/playtest.md",
    "check:levels": "tsx scripts/playtest/check.ts",
    "shots": "node scripts/screenshots.mjs",
    "submission": "node scripts/submission/build.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource/fredoka": "^5.2.8",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.6",
    "@types/three": "0.170.0",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.1",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.7"
  }
}
